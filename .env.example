# Private server environment (set in Vercel and Replit Secrets, never commit values)
FIREBASE_PROJECT_ID=iglifestyles
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_ADMIN_EMAIL=
UPI_VPA=
UPI_MERCHANT_NAME=ig.lifestyles

# Exact origins allowed to call the API from another origin
APP_ORIGIN=https://your-store.vercel.app
ALLOWED_ORIGINS=

# Public Firebase Cloud Messaging Web Push key from Firebase Console
VITE_FIREBASE_VAPID_KEY=
